{
  "name": "mcprouter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run codegen && next dev",
    "build": "drizzle-kit migrate && bun run codegen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "codegen": "bun scripts/codegen.ts && bun scripts/i18n.ts compile",
    "postinstall": "bun run codegen",
    "theme": "bun scripts/theme.ts",
    "tracker:report": "bun scripts/tracker-report.ts",
    "live-check": "bun --conditions=react-server scripts/live-check.ts",
    "catalog:sync": "bun --conditions=react-server scripts/sync-catalog.ts",
    "apis:import": "bun scripts/import-apis.ts",
    "telegram:webhook": "bun scripts/telegram-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "i18n:extract": "bun scripts/i18n.ts extract && bun scripts/i18n.ts compile",
    "i18n:check": "bun scripts/i18n.ts check"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.78",
    "@ai-sdk/react": "^4.0.147",
    "@json-render/core": "^0.21.1",
    "@json-render/react": "^0.21.1",
    "@libsql/client": "^0.18.0",
    "@material/material-color-utilities": "^0.4.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@rxtech-lab/authjs-rxlab": "1.6.1",
    "@vercel/functions": "^3.10.1",
    "ai": "^7.0.143",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "firebase": "^13.0.0",
    "lucide-react": "^1.59.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "satori": "^0.62.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
