exports[`codegen > generates a stable service module 1`] = `
"// Generated by scripts/codegen.ts. Do not edit; change the service YAML and run \`bun run codegen\`.
// Source: mcp/services/example/service.yaml
import type { McpServer } from "@modelcontextprotocol/server";
import { z } from "zod";
import { registerServices } from "@/lib/mcp/register";
import type { CallerContext, ServiceDefinition } from "@/lib/mcp/types";
import * as handlers from "@/mcp/services/example/handlers";

export const service: ServiceDefinition = {
  "id": "example",
  "title": "Example Service",
  "description": "A fixture covering every feature of the YAML spec.",
  "aliases": [],
  "datasets": [
    "example-dataset"
  ],
  "baseUrl": "https://api.example.test/v1",
  "lang": {
    "param": "language",
    "in": "query",
    "map": {
      "en": "EN",
      "tc": "ZH",
      "sc": "ZH"
    }
  },
  "cacheTtl": 60,
  tools: [
    {
      name: "example_items",
      title: "List items",
      description: "Items, filtered locally.",
      spec: {
        "name": "example_items",
        "title": "List items",
        "description": "Items, filtered locally.",
        "method": "GET",
        "path": "/items/{category}",
        "query": {
          "format": "json"
        },
        "input": {
          "category": {
            "type": "string",
            "description": "Item category",
            "required": true,
            "transform": "lower"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "tc",
              "sc"
            ],
            "default": "en",
            "required": false
          },
          "name": {
            "type": "string",
            "description": "Text in the name",
            "required": false,
            "in": "local"
          },
          "code": {
            "type": "string",
            "required": false,
            "in": "local",
            "transform": "upper"
          },
          "limit": {
            "type": "integer",
            "required": false,
            "name": "max",
            "minimum": 1,
            "maximum": 10
          }
        },
        "response": {
          "format": "json",
          "root": "data.items",
          "filter": {
            "code": "code"
          },
          "search": {
            "input": "name",
            "fields": [
              "name_en",
              "name_tc"
            ]
          },
          "pick": [
            "code",
            "name_en"
          ],
          "limit": 2
        },
        "app": true
      },
      inputSchema: z.object({
        "category": z.string().describe("Item category"),
        "lang": z.enum(["en","tc","sc"]).default("en"),
        "name": z.string().describe("Text in the name").optional(),
        "code": z.string().optional(),
        "limit": z.number().int().min(1).max(10).optional(),
      }),
    },
    {
      name: "example_submit",
      description: "POST with a body.",
      spec: {
        "name": "example_submit",
        "description": "POST with a body.",
        "method": "POST",
        "path": "/submit",
        "body": {
          "fixed": true
        },
        "input": {
          "route": {
            "type": "string",
            "required": true,
            "in": "body",
            "name": "routeName"
          },
          "level": {
            "type": "number",
            "enum": [
              1,
              2
            ],
            "required": false
          }
        },
        "app": true
      },
      inputSchema: z.object({
        "route": z.string(),
        "level": z.union([z.literal(1), z.literal(2)]).optional(),
      }),
    },
    {
      name: "example_custom",
      description: "Uses a handler.",
      spec: {
        "name": "example_custom",
        "description": "Uses a handler.",
        "method": "GET",
        "input": {
          "flag": {
            "type": "boolean",
            "default": false,
            "required": false
          }
        },
        "app": true
      },
      inputSchema: z.object({
        "flag": z.boolean().default(false),
      }),
      handler: handlers.custom,
    },
    {
      name: "example_transformed",
      description: "YAML request with code transformers.",
      spec: {
        "name": "example_transformed",
        "description": "YAML request with code transformers.",
        "method": "GET",
        "path": "/feed",
        "input": {
          "q": {
            "type": "string",
            "required": true
          }
        },
        "response": {
          "format": "json",
          "root": "entries",
          "limit": 200
        },
        "transform": {
          "request": "signRequest",
          "response": "unwrapFeed"
        },
        "app": true
      },
      inputSchema: z.object({
        "q": z.string(),
      }),
      transformRequest: handlers.signRequest,
      transformResponse: handlers.unwrapFeed,
    },
  ],
};

export function registerTools(server: McpServer, caller: CallerContext) {
  registerServices(server, [service], caller);
}
"
`;

exports[`codegen > generates a stable service module 2`] = `
"// Generated by scripts/codegen.ts. Do not edit; change the service YAML and run \`bun run codegen\`.
import type { ServiceDefinition } from "@/lib/mcp/types";
import { service as example } from "./services/example";

export const services: readonly ServiceDefinition[] = [example];

/** By id, and by every alias (the id of a service merged into it). */
export const serviceById = new Map(services.flatMap((service) => [service.id, ...service.aliases].map((id) => [id, service] as const)));
"
`;
