# RxLab Auth (OIDC)
AUTH_ISSUER=https://auth.rxlab.app
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=
# Local only: skip sign-in and act as a fixed development user.
DEV_BYPASS_AUTH=false

# Public origin. Also the OAuth issuer and token audience for the MCP endpoints, so set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Search Console URL-prefix verification token (the content value, not an HTML tag).
GOOGLE_SITE_VERIFICATION=

# Browser-visible Mapbox public token (pk.) for Dark map tiles.
# MAPBOX_API_KEY is also accepted when it contains a public token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Server-side Directions token for the agent's draw_route tool. Falls back to
# MAPBOX_API_KEY or NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN. Must allow server requests.
MAPBOX_DIRECTIONS_ACCESS_TOKEN=

# Firebase / Google Analytics (G-F4NMJNMGMF). Set false to disable collection.
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# rx-subscription (plans, usage, checkout)
RX_SUBSCRIPTION_URL=
RX_SUBSCRIPTION_API_KEY=
# When false, chat messages and tool calls are not metered against rx-subscription.
# Usage items and balance units are configured in lib/billing/config.ts.
BILLING_ENABLED=false

# Turso / libsql. Defaults to file:local.db when unset.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# AI agent
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5-5
# AI Gateway embedding model the agent's tool search uses to match questions to tools.
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# JSON list of MCP servers for the agent. "self" means this app's /api/mcp/streamable.
AGENT_MCP_SERVERS=[{"name":"hk","url":"self","headers":{}}]
# Optional: serve the MCP Apps sandbox page (/mcp-app-sandbox of this app) from another origin. Defaults to this origin.
NEXT_PUBLIC_MCP_APP_SANDBOX_URL=
# Free agent for signed-out visitors (/try). Messages per visitor per Hong Kong day; 0 turns it off.
FREE_CHAT_DAILY_LIMIT=15
# Cap per network address so clearing cookies doesn't reset the allowance. Defaults to 4x the visitor limit.
FREE_CHAT_IP_DAILY_LIMIT=
# Model for the free agent. Defaults to AI_MODEL.
FREE_CHAT_MODEL=
# Shared secret the agent uses to call this app's MCP endpoint for the signed-in user.
MCPROUTER_INTERNAL_KEY=

# WhatsApp bot (WasenderAPI). Webhook: <site>/api/whatsapp, with the "messages.received" event.
# Unset either of the first two to turn it off. Numbers are linked to accounts and use free messages before paid billing.
WASENDER_API_KEY=
# The session's webhook secret, sent back as X-Webhook-Signature on every webhook.
WASENDER_WEBHOOK_SECRET=
# The bot's number in international format, for "Chat on WhatsApp" links (optional).
WHATSAPP_BOT_NUMBER=
# Model for WhatsApp replies. Defaults to AI_MODEL.
WHATSAPP_MODEL=

# Telegram bot (Bot API). Create a bot with @BotFather, then run `bun run telegram:webhook https://<site>`
# to point it at <site>/api/telegram. Unset either of the first two to turn it off. Accounts are linked and use free messages before paid billing.
TELEGRAM_BOT_TOKEN=
# Random secret (A-Z, a-z, 0-9, _ and -) Telegram sends back as X-Telegram-Bot-Api-Secret-Token on every webhook.
TELEGRAM_WEBHOOK_SECRET=
# The bot's username without @, for "Chat on Telegram" links (optional).
TELEGRAM_BOT_USERNAME=
# Model for Telegram replies. Defaults to AI_MODEL.
TELEGRAM_MODEL=

# Enable only after installing the matching Cloudflare rules (docs/cloudflare-cache.md).
# Production only; cookie-bearing, localized, API and RSC requests bypass the cache.
PUBLIC_CDN_CACHE_ENABLED=false

# AI SDK Decision API model for Search intent routing (separate from the chat model).
SEARCH_DECISION_MODEL=typesafe-ai/jev

# Hacker News needs no credentials.
# Unified news (RapidAPI subscriptions to both Trade Bloom Finance and Reuters API).
# Server-only; Next.js loads this from .env. Never use a NEXT_PUBLIC_ prefix.
RAPIDAPI_KEY=

# Firecrawl v2, server-only. Used for news search and cached article body retrieval.
FIRECRAWL_API_KEY=
# AI Gateway Decision API for checking whether provider detail contains an article body.
NEWS_DECISION_MODEL=typesafe-ai/jev
