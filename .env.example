# RxLab Auth (OIDC)
AUTH_ISSUER=https://auth.rxlab.app
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=
# Local only: skip sign-in and act as a fixed development user.
DEV_BYPASS_AUTH=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# rx-subscription (plans, usage, checkout)
RX_SUBSCRIPTION_URL=
RX_SUBSCRIPTION_API_KEY=
# When false, tool calls are not metered against rx-subscription.
BILLING_ENABLED=false
# rx-subscription usage item recorded once per MCP tool call.
RX_SUBSCRIPTION_USAGE_ITEM=mcp_calls
# Balance unit each MCP tool call is paid from (1 per call); the usage item then only tracks calls.
# Leave empty to gate calls on the plan allowance alone and show every balance.
RX_SUBSCRIPTION_CREDIT_UNIT=

# Turso / libsql. Defaults to file:local.db when unset.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# AI agent
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5-5
# AI Gateway embedding model the agent's tool search uses to match questions to tools.
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# JSON list of MCP servers for the agent. "self" means this app's /api/mcp/mcp.
AGENT_MCP_SERVERS=[{"name":"hk","url":"self","headers":{}}]
# Free agent for signed-out visitors (/try). Messages per visitor per Hong Kong day; 0 turns it off.
FREE_CHAT_DAILY_LIMIT=15
# Cap per network address so clearing cookies doesn't reset the allowance. Defaults to 4x the visitor limit.
FREE_CHAT_IP_DAILY_LIMIT=
# Model for the free agent. Defaults to AI_MODEL.
FREE_CHAT_MODEL=
# Shared secret the agent uses to call this app's MCP endpoint for the signed-in user.
MCPROUTER_INTERNAL_KEY=

# Bearer secret Vercel cron sends to /api/cron/sync-catalog.
CRON_SECRET=
